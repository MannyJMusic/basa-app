# =============================================================================
# BASA Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in your actual values
# cp .env.production.example .env.production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL="postgresql://basa_user:basa_password@postgres:5432/basa_db"

# =============================================================================
# NEXT.JS & AUTHENTICATION
# =============================================================================
NEXTAUTH_URL="https://app.businessassociationsa.com"
NEXTAUTH_SECRET="your-production-nextauth-secret-key-here"

# =============================================================================
# STRIPE PAYMENT PROCESSING (REQUIRED)
# =============================================================================
STRIPE_SECRET_KEY="sk_live_your-stripe-secret-key"
STRIPE_RESTRICTED_KEY="rk_live_your-stripe-restricted-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# =============================================================================
# EMAIL CONFIGURATION (REQUIRED)
# =============================================================================
MAILGUN_API_KEY="key-your-mailgun-api-key"
MAILGUN_DOMAIN="your-domain.com"
MAILGUN_FROM_EMAIL="noreply@your-domain.com"

# =============================================================================
# SENTRY ERROR MONITORING (OPTIONAL)
# =============================================================================
# Server-side DSN. Project settings -> Client Keys (DSN) in Sentry.
SENTRY_DSN="https://your-sentry-dsn@sentry.io/your-project-id"
# Browser DSN, inlined at build time. Usually the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/your-project-id"
# Slugs, not display names (see the URL in Sentry).
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"
# Org auth token for source-map upload during `next build`. Leave empty to build without uploading.
SENTRY_AUTH_TOKEN=""

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://app.businessassociationsa.com"

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
POSTGRES_DB="basa_db"
POSTGRES_USER="basa_user"
POSTGRES_PASSWORD="basa_password"

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
API_RATE_LIMIT="100"
SESSION_TIMEOUT="30"

# =============================================================================
# REQUIRED VARIABLES FOR PRODUCTION
# =============================================================================
# You MUST set these variables for production:
# - DATABASE_URL
# - NEXTAUTH_URL
# - NEXTAUTH_SECRET
# - STRIPE_SECRET_KEY
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# - MAILGUN_API_KEY
# - MAILGUN_DOMAIN
# - MAILGUN_FROM_EMAIL 